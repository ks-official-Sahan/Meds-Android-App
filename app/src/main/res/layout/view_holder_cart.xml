<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cart_item_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="12dp"
    app:cardCornerRadius="18dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    app:strokeColor="?attr/colorNeutral100"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="start|center_vertical"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp">

            <ImageView
                android:id="@+id/cart_item_img"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="top|center"
                android:contentDescription="@string/title_medications"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/med_asset_01" />
        </com.google.android.material.card.MaterialCardView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="10dp"
            android:layout_marginVertical="4dp"
            android:paddingTop="0dp">

            <TextView
                android:id="@+id/cart_item_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:gravity="start"
                android:maxLines="2"
                android:text="Title"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/cart_item_delete"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/cart_item_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Price"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cart_item_category" />

            <TextView
                android:id="@+id/cart_item_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Category"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cart_item_title" />

            <!--  Quantity Mechanism  -->
            <ImageView
                android:id="@+id/cart_item_decrement"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="4dp"
                android:contentDescription="@string/decrement"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_minus"
                app:layout_constraintBottom_toBottomOf="@+id/cart_item_quantity"
                app:layout_constraintEnd_toStartOf="@+id/cart_item_quantity"
                app:layout_constraintTop_toTopOf="@+id/cart_item_quantity" />

            <ImageView
                android:id="@+id/cart_item_increment"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="4dp"
                android:contentDescription="@string/increment"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_add"
                app:layout_constraintBottom_toBottomOf="@+id/cart_item_quantity"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/cart_item_quantity" />

            <EditText
                android:id="@+id/cart_item_quantity"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:autofillHints="Quantity"
                android:ems="10"
                android:gravity="center_horizontal"
                android:inputType="number|numberDecimal"
                android:text="@string/_1"
                android:textSize="14sp"
                android:textAlignment="center"
                app:layout_constraintBottom_toBottomOf="@+id/cart_item_price"
                app:layout_constraintEnd_toStartOf="@+id/cart_item_increment"
                app:layout_constraintTop_toTopOf="@+id/cart_item_price"
                tools:ignore="LabelFor" />

            <ImageView
                android:id="@+id/cart_item_delete"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_delete"
                app:tint="?attr/colorError"
                app:layout_constraintBottom_toBottomOf="@+id/cart_item_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/cart_item_title" />
            <!--  Quantity Mechanism  -->
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
