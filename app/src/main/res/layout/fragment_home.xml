<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:padding="2dp"
    android:paddingBottom="0dp"
    tools:context=".fragment.navigation.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:fillViewport="true"> <!-- Ensures the scroll view fills the available space -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:paddingBottom="4dp">

            <EditText
                android:id="@+id/home_search"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:autofillHints="Reminder name, time, date | Medication name"
                android:background="@drawable/background_rounded"
                android:hint="@string/search_home"
                android:inputType="text"
                android:paddingHorizontal="24dp"
                android:paddingBottom="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!--  Dates  -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/date_recycler"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/home_search" />
            <!--  Dates  -->

            <!--  Reminders  -->
            <TextView
                android:id="@+id/reminder_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:text="@string/my_reminders"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/date_recycler" />

            <TextView
                android:id="@+id/reminder_view_all_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/view_all"
                android:textColor="?attr/colorTintHigh"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/reminder_refresh_home"
                app:layout_constraintEnd_toStartOf="@+id/reminder_refresh_home"
                app:layout_constraintTop_toTopOf="@+id/reminder_refresh_home" />

            <ImageView
                android:id="@+id/reminder_refresh_home"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/refresh"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_refresh"
                app:layout_constraintBottom_toBottomOf="@+id/reminder_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/reminder_text"
                app:tint="?attr/colorTintMid" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/reminder_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/reminder_text">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/reminder_recycler"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="gone" />

                <!--  No Reminders  -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/reminder_empty_view_home"
                    android:layout_width="250dp"
                    android:layout_height="200dp"
                    android:layout_margin="16dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/empty_reminders_img_home"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_marginBottom="20dp"
                        android:contentDescription="@string/no_reminders"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_reminder"
                        app:tint="?attr/colorTintHigh"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_reminders"
                        android:textSize="25sp"
                        android:textStyle="italic"
                        android:textColor="?attr/colorTintHigh"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/empty_reminders_img_home" />

                </androidx.constraintlayout.widget.ConstraintLayout>
                <!--  No Reminders  -->
            </androidx.constraintlayout.widget.ConstraintLayout>
            <!--  Reminders  -->

            <!--  Medications  -->
            <TextView
                android:id="@+id/medication_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:text="@string/my_medications"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/reminder_container" />

            <TextView
                android:id="@+id/medication_view_all_home"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/view_all"
                android:textColor="?attr/colorTintHigh"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/medication_refresh_home"
                app:layout_constraintEnd_toStartOf="@+id/medication_refresh_home"
                app:layout_constraintTop_toTopOf="@+id/medication_refresh_home" />

            <ImageView
                android:id="@+id/medication_refresh_home"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="@string/refresh"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_refresh"
                app:layout_constraintBottom_toBottomOf="@+id/medication_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/medication_text"
                app:tint="?attr/colorTintMid" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/medication_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:clipChildren="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/medication_text">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/medication_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="gone" />

                <!--  No Medications  -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/medication_empty_view_home"
                    android:layout_width="250dp"
                    android:layout_height="200dp"
                    android:layout_margin="16dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/empty_medications_img_home"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_marginBottom="20dp"
                        android:contentDescription="@string/no_medications"
                        app:tint="?attr/colorTintHigh"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_medication"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_medications"
                        android:textSize="25sp"
                        android:textStyle="italic"
                        android:textColor="?attr/colorTintHigh"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/empty_medications_img_home" />

                </androidx.constraintlayout.widget.ConstraintLayout>
                <!--  No Medications  -->
            </androidx.constraintlayout.widget.ConstraintLayout>
            <!--  Medications  -->

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!--  Today Btn  -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="76dp"
        android:backgroundTint="?attr/colorTint"
        android:contentDescription="@string/app_name"
        android:scaleType="fitXY"
        android:visibility="visible"
        app:srcCompat="@drawable/ic_today"
        app:tint="?attr/colorTintHigh"
        tools:visibility="visible" />

