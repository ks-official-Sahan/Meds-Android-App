<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1B000000"/> <!-- Semi-transparent black shadow -->
            <corners android:radius="18dp"/>
        </shape>
    </item>

    <!-- Main Background -->
    <item android:bottom="1dp" android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:layout_width="match_parent">
            <solid android:color="?attr/colorNeutral100" />
<!--            <stroke android:width="1dp" android:color="?attr/colorNeutral300" />-->
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>