<?xml version="1.0" encoding="utf-8"?>
<!-- File: res/layout/activity_order_complete.xml -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.store.OrderCompleteActivity">

    <!-- Order Confirmation Image with rounded corners -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/orderImageCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp">

        <ImageView
            android:id="@+id/imageViewOrder"
            android:layout_width="300dp"
            android:layout_height="350dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/order_complete"
            app:srcCompat="@drawable/order_confirm" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Order Confirmation Message -->
    <TextView
        android:id="@+id/tvOrderConfirmed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/your_order_is_confirmed"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/orderImageCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Order Details Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardOrderDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvOrderConfirmed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Order ID Label -->
            <TextView
                android:id="@+id/tvOrderIdLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_id_"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Order ID Value -->
            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100520310"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/tvOrderIdLabel"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Total Label -->
            <TextView
                android:id="@+id/tvTotalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="@string/total"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tvOrderIdLabel"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp" />

            <!-- Order Total Value -->
            <TextView
                android:id="@+id/tvOrderTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="600 LKR"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tvOrderId"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons Container (using two MaterialButtons) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/order_confirm_view_btn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:text="@string/view_orders"
        android:textSize="16sp"
        app:backgroundTint="?attr/colorSecondary500"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/order_confirm_continue_btn"
        app:layout_constraintEnd_toStartOf="@+id/order_confirm_continue_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/order_confirm_continue_btn" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/order_confirm_continue_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/continue_shopping"
        android:textSize="16sp"
        app:cornerRadius="8dp"
        app:backgroundTint="?attr/colorPrimary"
        app:layout_constraintStart_toEndOf="@+id/order_confirm_view_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
