<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:fitsSystemWindows="true"
    tools:context=".activity.home.HomeActivity"
    tools:openDrawer="start">

    <!-- Main Content -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:clipChildren="false">

        <!-- Custom Toolbar using ConstraintLayout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/custom_toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/background_nav_top"
            android:elevation="5dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingVertical="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Menu Icon -->
            <ImageView
                android:id="@+id/action_menu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/menu"
                android:src="@drawable/ic_menu"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                app:tint="?attr/colorNeutral500"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Home Logo -->
            <ImageView
                android:id="@+id/action_home"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/logo"
                android:src="?attr/logo"
                android:scaleType="centerCrop"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                app:layout_constraintStart_toEndOf="@id/action_menu"
                app:layout_constraintEnd_toStartOf="@+id/action_profile_container"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0.5" />

            <!-- Profile Icon inside a CardView -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/action_profile_container"
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:cardCornerRadius="21dp"
                app:strokeColor="?attr/colorNeutral300"
                app:strokeWidth="3dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/action_profile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/title_profile"
                    android:src="@drawable/ic_profile"
                    android:scaleType="centerCrop"
                    app:tint="?attr/colorNeutral500" />
            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
        <!-- End Custom Toolbar -->

        <!-- Navigation Host Fragment -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragmentContainerViewHome"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="56dp"
            android:paddingBottom="72dp"
            android:clipChildren="false"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <!-- Floating Action Buttons -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="124dp"
            android:contentDescription="@string/title_shop"
            app:srcCompat="@drawable/ic_shop"
            app:tint="?attr/colorTintHigh"
            android:backgroundTint="?attr/colorTint"
            app:layout_anchor="@id/fragmentContainerViewHome"
            app:layout_anchorGravity="bottom|end"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Bottom Navigation -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation_view_user"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/background_nav_bottom"
            app:itemActiveIndicatorStyle="@drawable/background_menu_item"
            app:itemIconTint="?attr/colorNeutral500"
            app:itemIconSize="24dp"
            app:itemPaddingTop="8dp"
            android:layout_marginBottom="-24dp"
            app:itemPaddingBottom="32dp"
            app:itemTextAppearanceActive="@style/BottomNavTextAppearanceActive"
            app:itemTextAppearanceInactive="@style/BottomNavTextAppearanceInactive"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/user_bottom_nav_menu_home" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view_user"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorNeutral50"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/user_nav_header"
        app:itemBackground="@drawable/background_menu_item"
        app:menu="@menu/user_navigation_menu"
        tools:visibility="gone" />

</androidx.drawerlayout.widget.DrawerLayout>
